    "import qrcode \n",
    "upiid = input(\"Enter UPI ID: \")\n",
    "name = input(\"Enter Name: \")\n",
    "amount = input(\"Enter Amount: \")\n",
    "\n",
    "upi_url = f\"upi://pay?pa={upiid}&pn={name}&am={amount}\"\n",
    "\n",
    "#pa payee \n",
    "#pn payee name\n",
    "#cu currency\n",
    "#am amount\n",
    "\n",
    "qr = qrcode.make(upi_url)\n",
    "qr.save(r\"C:\\Users\\Kavyansh Sharma\\OneDrive\\Documents\\Python-Projects\\Mini Project 1 (QR CREATION)\\Kavyansh_upi.png\")\n",
    "qr.show()\n",
    "print(\"QR code generated successfully!\")\n",
    "\n",
    "print(\"Kavyansh Sharma\")"
   ]
